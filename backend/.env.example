# Flask Server Settings
FLASK_APP=app:create_app
FLASK_ENV=production
FLASK_RUN_PORT=5000
PORT=5000
LOG_LEVEL=INFO

# Service Internal DB (SQLite)
# 로컬 로컬 테스트 시에는 sqlite:///./ppe_guard.db 
# 도커 환경에서는 공유 볼륨으로 지정된 sqlite:////app/ppe_guard.db 를 권장합니다.
SERVICE_DATABASE_URI=sqlite:///./ppe_guard.db

# Storage
UPLOAD_DIR=uploads

# Analysis / AI Subsystem configuration
AI_DETECTOR_PROVIDER=mock
AI_OCR_PROVIDER=mock
FRAME_INTERVAL_SEC=1
OCR_INTERVAL_SEC=1
SEGMENT_DURATION_SECONDS=10
ANALYSIS_FPS=1
MAX_CONCURRENT_SEGMENTS=2
VIDEO_PIPELINE_QUEUE_SIZE=4
YOLO_QUEUE_SIZE=4
OCR_QUEUE_SIZE=8
WEBCAM_CAPTURE_FPS=10
WEBCAM_ANALYSIS_FPS=3
WEBCAM_FRAME_QUEUE_SIZE=4
WEBCAM_EVENT_QUEUE_SIZE=8
WEBCAM_RESULT_WINDOW_SECONDS=10
WEBCAM_TRACK_EXPIRY_SECONDS=5
WEBCAM_MAX_TRACK_OCR_COUNT=6
SEGMENT_RESULT_TTL_SECONDS=10
YOLO_WORKER_COUNT=1
OCR_WORKER_COUNT=1
EMPLOYEE_NUMBER_REGEX=^[0-9]+$
EMPLOYEE_NO_REGEX=^[0-9]+$
EMPLOYEE_NO_MIN_LENGTH=3
EMPLOYEE_NO_MAX_LENGTH=10
EMPLOYEE_NUMBER_MIN_CONFIRM_COUNT=2

# =========================================================
# 고객사 사내망 DB 연동 (탐지 결과 detection_result 릴레이 적재용)
# 아래 필수 설정값이 누락되면 앱 구동 시 또는 저장 시 에러가 발생할 수 있습니다.
# =========================================================
CUSTOMER_DB_HOST=192.168.1.100
CUSTOMER_DB_PORT=3306
CUSTOMER_DB_NAME=customer_ppe_db
CUSTOMER_DB_USER=ppeadmin
CUSTOMER_DB_PASSWORD=customer_dummy_pw
CUSTOMER_DB_DRIVER=mysql+pymysql
